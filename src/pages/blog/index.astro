---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import { articles, dzenChannelUrl } from '../../data/articles';
---
<BaseLayout title="Блог — Вулкан Маркетинг | Статьи об Авито" description="Блог агентства Вулкан Маркетинг: статьи и разборы о продвижении, аналитике, объявлениях и продажах на Авито.">
  <SiteHeader active="blog" />
  <main id="main" class="blog-page">
    <section class="blog-index-hero">
      <div class="container">
        <nav class="blog-breadcrumbs" aria-label="Навигационная цепочка"><a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Блог</span></nav>
        <div class="blog-index-heading">
          <div><p class="section-kicker"><span class="kicker-line"></span>Блог Вулкан Маркетинг</p><h1>Авито.<br/><span>По существу.</span></h1></div>
          <p>Статьи, наблюдения и разборы о продвижении бизнеса на Авито. Практика, аналитика и работа с объявлениями.</p>
        </div>
      </div>
    </section>
    <section class="blog-archive section-space" aria-labelledby="blog-archive-title">
      <div class="container">
        <div class="blog-archive-heading"><h2 id="blog-archive-title">Материалы</h2><span>{articles.length} материала</span></div>
        <div class="blog-cards-grid">{articles.map(article => <ArticleCard article={article} />)}</div>
        {articles.some(article => article.status === 'preview') && <div class="blog-import-notice">
          <p><strong>Сейчас представлены анонсы.</strong> Полные тексты и первые фотографии будут добавлены после переноса оригинальных материалов с Дзена.</p>
          <a href={dzenChannelUrl} target="_blank" rel="noopener noreferrer">Перейти на канал в Дзене <Icon name="arrow" size={18} /></a>
        </div>}
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
