---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { publishedArticles } from '../../data/articles';

const articleCount = publishedArticles.length;
const countForm = new Intl.PluralRules('ru-RU').select(articleCount);
const articleUnit = countForm === 'one' ? 'материал' : countForm === 'few' ? 'материала' : 'материалов';
---
<BaseLayout title="Блог — Вулкан Маркетинг | Статьи об Авито" description="Блог агентства Вулкан Маркетинг: статьи и разборы о продвижении, аналитике, объявлениях и продажах на Авито.">
  <SiteHeader active="blog" />
  <main id="main" class="blog-page">
    <section class="blog-index-hero">
      <div class="container">
        <nav class="blog-breadcrumbs" aria-label="Навигационная цепочка"><a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Блог</span></nav>
        <div class="blog-index-heading">
          <div><p class="section-kicker"><span class="kicker-line"></span>Блог Вулкан Маркетинг</p><h1>Авито.<br/><span>По существу.</span></h1></div>
          <p>Статьи, наблюдения и разборы о продвижении бизнеса на Авито. Практика, аналитика и работа с объявлениями.</p>
        </div>
      </div>
    </section>
    <section class="blog-archive section-space" aria-labelledby="blog-archive-title">
      <div class="container">
        <div class="blog-archive-heading"><h2 id="blog-archive-title">Материалы</h2><span>{articleCount} {articleUnit}</span></div>
        <div class="blog-cards-grid">{publishedArticles.map(article => <ArticleCard article={article} />)}</div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style is:global>
  .blog-index-hero {
    padding-block-start: clamp(1rem, 1.5vw, 1.375rem);
  }

  .blog-index-hero .blog-breadcrumbs {
    margin-block-end: clamp(1.5rem, 2.5vw, 2rem);
  }

  .blog-index-heading {
    display: grid;
    gap: clamp(1rem, 1.5vw, 1.25rem);
  }

  .blog-index-heading > p {
    max-inline-size: 62ch;
    line-height: 1.55;
  }

  .blog-archive {
    padding-block-start: clamp(2.5rem, 4vw, 3.5rem);
  }

  .blog-archive-heading {
    display: grid;
    gap: .5rem;
    margin-block-end: clamp(1.25rem, 2vw, 1.75rem);
  }

  .blog-archive-heading > span {
    color: var(--muted);
    font-size: .9375rem;
  }
</style>
