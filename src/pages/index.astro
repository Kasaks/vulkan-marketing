---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { hero, services, servicesIntro, cases, caseIntro, metrics, benefits, steps, processIntro, contactIntro, contacts, reviewSources } from '../data/site';
const links = [['#cases', 'Кейсы'], ['#process', 'Как работаем'], ['#services', 'Услуги'], ['#reviews', 'Отзывы'], ['#contact', 'Контакты']];
---
<BaseLayout>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="Вулкан Маркетинг — на главную">
        <img src="/images/logo.jpg" alt="" width="64" height="64" />
        <span class="brand-copy"><strong>Вулкан Маркетинг</strong><small>Маркетинговое агентство</small></span>
      </a>
      <nav id="main-nav" class="main-nav" aria-label="Основная навигация">
        {links.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
      <div class="header-actions">
        <button class="theme-toggle" type="button" aria-label="Переключить тему">
          <span class="sun"><Icon name="sun" size={18} /></span><span class="moon"><Icon name="moon" size={18} /></span>
        </button>
        <a class="button button-primary header-cta" href="#contact-dialog" data-dialog-open="contact-dialog">Обсудить задачу <Icon name="arrow" size={20} /></a>
        <button class="menu-toggle icon-button" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="main-nav"><Icon name="menu" /></button>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-shell">
        <div class="hero-copy">
          <p class="hero-tag"><span class="tag-dot"></span>{hero.eyebrow}</p>
          <h1 id="hero-title">Ваш отдел<br />маркетинга<br /><span>на Авито</span></h1>
          <p class="hero-description">{hero.description}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#contact-dialog" data-dialog-open="contact-dialog">Обсудить задачу <Icon name="arrow" size={21} /></a>
            <a class="button button-outline" href="#cases">{hero.secondary} <Icon name="arrow" size={20} /></a>
          </div>
          <p class="hero-caption">{hero.caption}</p>
        </div>
        <div class="hero-art" aria-label="Декоративная иллюстрация ноутбука с демонстрационным интерфейсом объявлений">
          <div class="coral-shape" aria-hidden="true"></div>
          <div class="lava-shape" aria-hidden="true"></div>
          <div class="hero-laptop" aria-hidden="true">
            <div class="laptop-lid">
              <div class="laptop-screen-content">
                <div class="mock-header"><strong><span class="avito-dots"><i></i><i></i><i></i><i></i></span> авито</strong><span class="mock-search"></span><span class="mock-search-btn"></span></div>
                <div class="mock-toolbar"><span></span><span></span><span></span></div>
                <div class="mock-listing"><div class="mock-photo photo-one"><span></span></div><div class="mock-lines"><i></i><i></i><i></i><b></b></div></div>
                <div class="mock-listing"><div class="mock-photo photo-two"><span></span></div><div class="mock-lines"><i></i><i></i><i></i><b></b></div></div>
                <div class="mock-listing"><div class="mock-photo photo-three"><span></span></div><div class="mock-lines"><i></i><i></i><i></i><b></b></div></div>
              </div>
            </div>
            <div class="laptop-bottom"></div>
          </div>
          <div class="float-card card-one"><span class="float-icon"><Icon name="chart" size={25} /></span><strong>Улучшаем сильное</strong></div>
          <div class="float-card card-two"><span class="float-icon"><Icon name="target" size={27} /></span><strong>Избавляемся<br />от слабого</strong></div>
          <div class="float-card card-three"><span class="float-icon float-layers" aria-hidden="true">◇</span><strong>Делаем результат<br />понятнее</strong></div>
        </div>
      </div>
    </section>

    <section class="metrics-section" aria-label="Показатели агентства">
      <div class="container metrics-grid">
        {metrics.map(m => <div class="metric-tile">
          <div class="metric-heading">
            <span class="metric-icon"><Icon name={m.icon} size={27} /></span>
            <span class="metric-label">{m.label}</span>
          </div>
          <strong>{m.number}</strong>
        </div>)}
      </div>
    </section>

    <section class="services section-space" id="services">
      <div class="container">
        <div class="section-heading"><div><p class="section-kicker"><span class="kicker-line"></span>Услуги</p><h2>Стандартные<br /><em>форматы сотрудничества</em></h2></div><p class="section-lead">{servicesIntro}</p></div>
        <div class="service-grid">
          {services.map(s => <article class="service-card">
            <div class="service-card-top"><span class="service-icon"><Icon name={s.icon} size={31} /></span></div>
            <h3>{s.title}</h3>
            <p>{s.description}</p>
            <div class="service-card-bottom"><span class="service-price"><strong>{s.price}</strong>{s.unit && <small>{s.unit}</small>}</span><a class="service-more" href={`#${s.id}-details`} data-dialog-open={`${s.id}-details`} aria-label={`Подробнее об услуге ${s.title}`}><Icon name="arrow" size={23} /></a></div>
          </article>)}
        </div>
      </div>
    </section>

    <section class="case-section section-space" id="cases">
      <div class="container">
        <div class="section-heading case-heading"><div><p class="section-kicker"><span class="kicker-line"></span>Кейсы</p><h2>Кейсы</h2></div><p class="section-lead">{caseIntro}</p></div>
        <div class="case-panel carousel" data-carousel="cases" tabindex="0">
          {cases.map((c, i) => <article class="case-slide" data-slide data-active={i === 0 ? 'true' : 'false'}>
            <div class="case-copy"><h3>{c.title}</h3><p class="case-description">{c.description}</p><p class="case-description">{c.niche}</p>
            </div>
            <div class="case-visual">
              {c.images.length ? <div class="case-gallery">{c.images.map((src, j) => <button type="button" class="gallery-thumb" data-gallery-open data-image-index={j} aria-label={`Увеличить изображение ${j + 1}`}><img src={src} alt={`Материал кейса ${j + 1}`} loading="lazy" /></button>)}</div> : <div class="case-placeholder"><div class="placeholder-window"><div class="placeholder-top"><span></span><span></span><span></span><b>Материалы проекта</b></div><div class="placeholder-bars"><i></i><i></i><i></i><i></i><i></i></div><div class="placeholder-row"><i></i><span></span><span></span></div><div class="placeholder-row"><i></i><span></span><span></span></div></div><p>Скриншоты статистики добавим после получения материалов.</p></div>}
            </div>
          </article>)}
          {cases.length > 1 && <div class="carousel-controls case-controls"><button class="round-button previous" type="button" data-prev aria-label="Предыдущий кейс"><Icon name="arrow" /></button><button class="round-button accent" type="button" data-next aria-label="Следующий кейс"><Icon name="arrow" /></button></div>}
        </div>
      </div>
    </section>

    <section class="benefits section-space" id="approach"><div class="container benefits-grid"><div class="benefits-heading"><p class="section-kicker"><span class="kicker-line"></span>Преимущества</p><h2>Понятно -<br />что делаем.<br /><em>Видно - зачем.</em></h2></div><div class="benefit-list">{benefits.map(([title, description]) => <article class="benefit-item"><div><h3>{title}</h3><p>{description}</p></div><span class="benefit-arrow">↗</span></article>)}</div></div></section>

    <section class="process section-space" id="process"><div class="container"><div class="section-heading"><div><p class="section-kicker"><span class="kicker-line"></span>Порядок работы</p><h2>От первого разговора<br /><em>до эффективной рекламы</em></h2></div><p class="section-lead">{processIntro}</p></div><ol class="steps">{steps.map(([title, description]) => <li><h3>{title}</h3><p>{description}</p></li>)}</ol></div></section>

    <section class="reviews-section section-space" id="reviews"><div class="container reviews-layout"><div><p class="section-kicker"><span class="kicker-line"></span>Отзывы</p><h2>Отзывы</h2></div><div class="review-sources">{reviewSources.map(s => s.url ? <a class="review-source" href={s.url} target="_blank" rel="noopener noreferrer"><strong>{s.name}</strong><Icon name="arrow" size={22} /></a> : <div class="review-source pending"><strong>{s.name}</strong><small>Ссылка ожидается</small></div>)}</div></div></section>

    <section class="contact-section" id="contact"><div class="container contact-content"><div><p class="section-kicker"><span class="kicker-line"></span>Контакты</p><h2>Чем мы можем быть<br /><span>вам полезны?</span></h2><p>{contactIntro}</p><div class="direct-contacts">{contacts.map(c => c.url ? <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name} <Icon name="arrow" size={16} /></a> : <span>{c.name}</span>)}</div></div><button class="button contact-button" type="button" data-dialog-open="contact-dialog">Обсудить задачу <Icon name="arrow" size={24} /></button></div></section>
  </main>

  <footer class="site-footer"><div class="container footer-grid"><div class="footer-brand"><a href="/">Вулкан Маркетинг</a><p>Ваш отдел маркетинга на Авито</p></div><nav aria-label="Навигация в подвале"><a href="#main">В начало</a>{links.map(([href, label]) => <a href={href}>{label}</a>)}</nav><p class="footer-note">© {new Date().getFullYear()} Вулкан Маркетинг</p></div></footer>

  {services.map(s => <dialog id={`${s.id}-details`} class="detail-dialog"><div class="dialog-inner"><button class="dialog-close icon-button" type="button" data-close aria-label="Закрыть"><Icon name="close" /></button><span class="section-kicker">Услуги</span><h2>{s.title}</h2>
    <div class="service-detail-paragraphs">{s.detailParagraphs.map(text => <p>{text}</p>)}</div>
    <p class="service-detail-result"><strong>Результат работы:</strong> {s.result}</p>
    <p class="service-detail-meta"><strong>Цена:</strong> {s.price}{s.unit ? ` ${s.unit}` : ''}</p>
    {s.term && <p class="service-detail-meta"><strong>Срок:</strong> {s.term}</p>}
    {s.budget && <p class="service-detail-meta"><strong>Рекламный бюджет:</strong> {s.budget}</p>}
    <button class="button button-primary" type="button" data-contact-from-service>Обсудить задачу <Icon name="arrow" size={18} /></button></div></dialog>)}
  <dialog id="contact-dialog" class="project-dialog" aria-labelledby="contact-dialog-title"><div class="dialog-inner"><button class="dialog-close icon-button" type="button" data-close aria-label="Закрыть"><Icon name="close" /></button><span class="section-kicker">Связаться с нами</span><h2 id="contact-dialog-title">Обсудить задачу</h2><p>{contactIntro}</p><div class="contact-links">{contacts.map(c => c.url ? <a class="button button-primary" href={c.url} target="_blank" rel="noopener noreferrer">{c.name} <Icon name="arrow" size={18} /></a> : <span class="contact-pending">{c.name} · ссылка пока не добавлена</span>)}</div></div></dialog>
  <dialog id="gallery-dialog" class="gallery-dialog" aria-label="Просмотр изображений"><button type="button" data-close aria-label="Закрыть галерею">×</button><button type="button" data-gallery-prev aria-label="Предыдущее изображение">←</button><img alt="Увеличенный скриншот кейса" /><button type="button" data-gallery-next aria-label="Следующее изображение">→</button></dialog>
  <script src="../scripts/site.ts"></script>
</BaseLayout>