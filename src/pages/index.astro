---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProjectMockup from '../components/ProjectMockup.astro';
import { services, cases, benefits, steps, reviews } from '../data/site';
const links = [['#services', 'Услуги'], ['#cases', 'Кейсы'], ['#approach', 'Подход'], ['#contact', 'Контакты']];
---
<BaseLayout>
  <header class="site-header container">
    <a class="brand" href="/" aria-label="Вулкан Маркетинг — на главную"><img src="/images/logo.jpg" alt="Вулкан Маркетинг" width="76" height="76" fetchpriority="high" /></a>
    <nav id="main-nav" class="main-nav" aria-label="Основная навигация">{links.map(([href, label]) => <a href={href}>{label}</a>)}</nav>
    <div class="header-actions">
      <button class="theme-toggle" type="button" aria-label="Включить тёмную тему" aria-pressed="false"><span class="sun"><Icon name="sun" size={17}/></span><span class="moon"><Icon name="moon" size={17}/></span></button>
      <a class="button header-cta" href="#contact">Обсудить задачу <Icon name="arrow" size={19}/></a>
      <button class="menu-toggle icon-button" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="main-nav"><Icon name="menu"/></button>
    </div>
  </header>

  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-main">
        <h1 id="hero-title">Маркетинг<br/>начинается<br/>с ясности<span class="red-period">.</span></h1>
        <p class="hero-subtitle"><span class="dash"></span><span>Стратегия, реклама и аналитика<br class="desktop-break"/> для роста вашего бизнеса.</span></p>
      </div>
      <div class="hero-aside"><p>Помогаем компаниям понимать свою аудиторию, выбирать верные инструменты и выстраивать системный маркетинг.</p><a class="button" href="#contact">Обсудить задачу <Icon name="arrow" size={20}/></a><span class="hero-note">Начнём с разговора о вашем бизнесе</span></div>
    </section>

    <section class="services container" id="services" aria-labelledby="services-title">
      <h2 id="services-title" class="sr-only">Услуги маркетингового агентства</h2>
      <div class="service-grid">{services.map(service => <article class="service"><div class="service-heading"><span class="service-icon"><Icon name={service.icon} size={35}/></span><h3>{service.title}</h3></div><p>{service.description}</p><div class="service-price">от {service.price} ₽ <span>{service.unit}</span></div><a class="text-link" href={`#${service.id}-details`} data-dialog-open={`${service.id}-details`}>Подробнее <Icon name="arrow" size={19}/></a></article>)}</div>
      <p class="demo-note">Тестовые цены для макета. Состав услуг и стоимость уточняются.</p>
    </section>

    <section class="case-section" id="cases" aria-label="Кейсы — примеры оформления">
      <div class="container carousel" data-carousel="cases" role="region" aria-roledescription="карусель" aria-label="Примеры проектов" tabindex="0">
        {cases.map((project, i) => <article class="case-slide" data-slide data-active={i === 0 ? 'true' : 'false'} role="group" aria-roledescription="слайд" aria-label={`${i + 1} из ${cases.length}`}>
          <div class="case-copy"><p class="eyebrow"><span class="dash"></span>Кейсы <span class="demo-tag">Пример оформления</span></p><h2>{project.title}</h2><p class="case-category">{project.category}</p><dl class="case-facts"><div><dt>Задача</dt><dd>{project.task}</dd></div><div><dt>Решение</dt><dd>{project.solution}</dd></div><div><dt>Оценка результата</dt><dd>{project.result}</dd></div></dl></div>
          <ProjectMockup project={project}/>
        </article>)}
        <div class="carousel-controls case-controls"><button class="round-button previous" type="button" data-prev aria-label="Предыдущий кейс"><Icon name="arrow" size={20}/></button><button class="round-button accent" type="button" data-next aria-label="Следующий кейс"><Icon name="arrow" size={20}/></button><span class="carousel-count" data-count aria-live="polite" aria-atomic="true">01 <span>/ 03</span></span></div>
        <p class="case-disclaimer">Учебные примеры — реальные проекты и результаты добавим позже.</p>
      </div>
    </section>

    <section class="benefits container section-space" id="approach" aria-labelledby="benefits-title">
      <div><span class="dash"></span><h2 id="benefits-title">Почему<br/>с нами понятно</h2></div>
      <div class="benefit-list">{benefits.map(([title, description]) => <article><span class="dash"></span><div><h3>{title}</h3><p>{description}</p></div></article>)}</div>
    </section>

    <section class="process container section-space" id="process" aria-labelledby="process-title">
      <span class="dash"></span><h2 id="process-title">Как строится работа</h2>
      <ol class="steps">{steps.map(([title, description], i) => <li><span class="step-number">0{i + 1}</span><h3>{title}</h3><p>{description}</p></li>)}</ol>
    </section>

    <section class="reviews-section" id="reviews" aria-labelledby="reviews-title"><div class="container">
      <div class="review-heading"><span class="dash"></span><h2 id="reviews-title">Отзывы</h2><span class="section-note">В этом блоке будут реальные истории клиентов</span></div>
      <div class="review-carousel carousel" data-carousel="reviews" role="region" aria-roledescription="карусель" aria-label="Места для отзывов" tabindex="0"><div class="quote-mark" aria-hidden="true">“</div><div class="review-slides">{reviews.map((review, i) => <div class="review-slide" data-slide data-active={i === 0 ? 'true' : 'false'} role="group" aria-roledescription="слайд" aria-label={`${i + 1} из ${reviews.length}`}><p class="review-text">{review.text}</p><p class="review-person">{review.person}</p><p class="review-caption">{review.caption}</p></div>)}</div><div class="carousel-controls review-controls"><button class="round-button previous" type="button" data-prev aria-label="Предыдущий отзыв"><Icon name="arrow" size={20}/></button><button class="round-button accent" type="button" data-next aria-label="Следующий отзыв"><Icon name="arrow" size={20}/></button><span class="carousel-count" data-count aria-live="polite" aria-atomic="true">01 <span>/ 03</span></span></div></div>
    </div></section>

    <section class="contact container section-space" id="contact" aria-labelledby="contact-title"><div><span class="dash"></span><h2 id="contact-title">Обсудим вашу задачу?</h2><p>Расскажите о бизнесе и о том, что хотите изменить.</p></div><a class="button contact-button" href="#project-dialog" data-dialog-open="project-dialog">Обсудить проект <Icon name="arrow" size={22}/></a></section>
    <noscript><div class="container noscript-note">Для переключения темы, каруселей и открытия формы включите JavaScript. Всё содержимое страницы доступно ниже и выше.</div></noscript>
  </main>

  <footer class="site-footer container"><div class="footer-brand"><a href="/">Вулкан Маркетинг</a><p>Стратегия. Реклама. Аналитика.</p></div><nav aria-label="Навигация в подвале">{links.map(([href, label]) => <a href={href}>{label}</a>)}</nav><p class="footer-note">Тестовая версия<br/>Содержание для обсуждения</p></footer>

  {services.map(service => <dialog id={`${service.id}-details`} class="detail-dialog"><div class="dialog-inner"><button class="dialog-close icon-button" type="button" data-close aria-label="Закрыть описание услуги"><Icon name="close"/></button><span class="eyebrow red">Услуги / {service.title}</span><h2>{service.title}</h2><p>{service.detail}</p><ul>{service.items.map(item => <li><Icon name="check" size={18}/>{item}</li>)}</ul><p class="dialog-price">от {service.price} ₽ <span>{service.unit}</span></p><p class="demo-note">Тестовая цена и пример состава услуги.</p><button class="button" type="button" data-project-from-service={service.title}>Обсудить задачу <Icon name="arrow" size={19}/></button></div></dialog>)}

  <dialog id="project-dialog" class="project-dialog" aria-labelledby="project-dialog-title"><div class="dialog-inner"><button class="dialog-close icon-button" type="button" data-close aria-label="Закрыть форму"><Icon name="close"/></button><span class="eyebrow red">Начнём с разговора</span><h2 id="project-dialog-title">О вашей задаче</h2><p class="form-intro">Это тестовая форма: данные никуда не отправляются и не сохраняются.</p><form id="project-form"><label>Как к вам обращаться<input name="name" autocomplete="name" required maxlength="100" placeholder="Ваше имя"/></label><label>Контакт для связи<input name="contact" autocomplete="off" required maxlength="150" placeholder="Почта, телефон или Telegram"/></label><label>Коротко о задаче<textarea name="message" rows="3" maxlength="2000" placeholder="Что хотите изменить в маркетинге?"></textarea></label><button class="button" type="submit">Проверить форму <Icon name="arrow" size={20}/></button><p class="form-status" role="status" aria-live="polite"></p></form></div></dialog>
  <script src="../scripts/site.ts"></script>
</BaseLayout>
