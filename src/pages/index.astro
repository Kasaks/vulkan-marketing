---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CaseGallery from '../components/CaseGallery.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { services, cases, benefits, steps, metrics, reviewSources } from '../data/site';
const links = [['#cases', 'Кейсы'], ['#process', 'Как работаем'], ['#services', 'Услуги'], ['#reviews', 'Отзывы'], ['#contact', 'Контакты']];
---
<BaseLayout>
  <header class="site-header container">
    <a class="brand" href="/" aria-label="Вулкан Маркетинг — на главную"><img src="/images/logo.jpg" alt="" width="76" height="76" fetchpriority="high"/><span>Вулкан<br/>Маркетинг</span></a>
    <nav id="main-nav" class="main-nav" aria-label="Основная навигация">{links.map(([href, label]) => <a href={href}>{label}</a>)}</nav>
    <div class="header-actions">
      <button class="theme-toggle" type="button" aria-label="Включить тёмную тему" aria-pressed="false"><span class="sun"><Icon name="sun" size={17}/></span><span class="moon"><Icon name="moon" size={17}/></span></button>
      <a class="button header-cta" href="#contact" data-dialog-open="contact-dialog">Обсудить задачу <Icon name="arrow" size={19}/></a>
      <button class="menu-toggle icon-button" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="main-nav"><Icon name="menu"/></button>
    </div>
  </header>

  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-main">
        <p class="hero-eyebrow">Маркетинговое агентство «Вулкан Маркетинг»</p>
        <h1 id="hero-title">Ваш отдел<br/>маркетинга<br/>на Авито<span class="red-period">.</span></h1>
        <a class="text-link hero-cases" href="#cases">Посмотреть кейсы <Icon name="arrow" size={20}/></a>
      </div>
      <div class="hero-aside"><p>Находим в вашем продукте сильные и слабые стороны. Улучшаем сильное, избавляемся от слабого. Делаем результат понятнее, эффективнее и предсказуемее.</p><a class="button" href="#contact" data-dialog-open="contact-dialog">Обсудить задачу <Icon name="arrow" size={20}/></a><span class="hero-note">Расскажите нам о бизнесе и о том,<br/>куда хотите его привести.</span></div>
    </section>

    <section class="metrics container" aria-label="Агентство в цифрах"><ul>{metrics.map(metric => <li><span class="metric-icon"><Icon name={metric.icon} size={27}/></span><strong>{metric.value}</strong><span>{metric.label}</span></li>)}</ul></section>

    <section class="services container" id="services" aria-labelledby="services-title">
      <div class="services-heading"><span class="dash"></span><h2 id="services-title">Стандартные форматы<br/>сотрудничества</h2><p>Можно начать с отдельной задачи или собрать несколько направлений в общий план продвижения.</p></div>
      <div class="service-grid">{services.map(service => <article class="service"><div class="service-heading"><span class="service-icon"><Icon name={service.icon} size={32}/></span><h3>{service.title}</h3></div><p>{service.description}</p><div class="service-price">{service.pricePrefix}{service.price} ₽ <span>{service.unit}</span></div><a class="text-link" href={`#${service.id}-details`} data-dialog-open={`${service.id}-details`}>Подробнее <Icon name="arrow" size={19}/></a></article>)}</div>
      <p class="services-budget">Рекламный бюджет оплачивается отдельно.</p>
    </section>

    <section class="case-section" id="cases" aria-label="Кейсы продвижения на Авито">
      <div class="container carousel" data-carousel="cases" role="region" aria-roledescription="карусель" aria-label="Проекты агентства" tabindex="0">
        {cases.map((project, i) => <article class="case-slide" data-slide data-active={i === 0 ? 'true' : 'false'} role="group" aria-roledescription="слайд" aria-label={`${i + 1} из ${cases.length}`}>
          <div class="case-copy"><p class="eyebrow"><span class="dash"></span>Кейсы</p><h2>{project.title}</h2><p class="case-category">{project.category}</p><p class="case-intro">{project.intro}</p><dl class="case-facts">{project.facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.text}</dd></div>)}</dl></div>
          <CaseGallery project={project}/>
        </article>)}
        {cases.length > 1 && <div class="carousel-controls case-controls"><button class="round-button previous" type="button" data-prev aria-label="Предыдущий кейс"><Icon name="arrow" size={20}/></button><button class="round-button accent" type="button" data-next aria-label="Следующий кейс"><Icon name="arrow" size={20}/></button><span class="carousel-count" data-count aria-live="polite" aria-atomic="true">01 <span>/ {String(cases.length).padStart(2, '0')}</span></span></div>}
      </div>
    </section>

    <section class="benefits container section-space" id="approach" aria-labelledby="benefits-title">
      <div><span class="dash"></span><h2 id="benefits-title">Понятно —<br/>что делаем.<br/>Видно — зачем.</h2></div>
      <div class="benefit-list">{benefits.map(([title, description]) => <article><span class="dash"></span><div><h3>{title}</h3><p>{description}</p></div></article>)}</div>
    </section>

    <section class="process container section-space" id="process" aria-labelledby="process-title">
      <span class="dash"></span><h2 id="process-title">От первого разговора<br/>до понятного плана</h2>
      <ol class="steps">{steps.map(([title, description], i) => <li><span class="step-number">0{i + 1}</span><h3>{title}</h3><p>{description}</p></li>)}</ol>
    </section>

    <section class="reviews-section" id="reviews" aria-labelledby="reviews-title"><div class="container">
      <div class="review-heading"><span class="dash"></span><h2 id="reviews-title">Отзывы</h2><span class="section-note">На площадках Яндекса</span></div>
      <div class="review-sources">{reviewSources.map(source => <article><div><h3>{source.name}</h3><p>{source.description}</p></div>{source.url ? <a class="text-link" href={source.url} target="_blank" rel="noopener noreferrer">Читать отзывы <Icon name="arrow" size={20}/><span class="sr-only"> — открыть в новой вкладке</span></a> : <span class="source-pending">Ссылка появится позже</span>}</article>)}</div>
    </div></section>

    <section class="contact container section-space" id="contact" aria-labelledby="contact-title"><div><span class="dash"></span><h2 id="contact-title">Расскажите<br/>о своей задаче</h2><p>Что хотите изменить в маркетинге? Напишите нам напрямую — обсудим, с чего можно начать.</p><a class="button contact-button" href="#contact-channels" data-dialog-open="contact-dialog">Обсудить задачу <Icon name="arrow" size={22}/></a></div><div id="contact-channels" class="contact-channels"><p class="eyebrow">Связаться напрямую</p><ContactLinks/><p class="contact-note">Выберите удобный мессенджер. На сайте нет формы для сбора данных.</p></div></section>
    <noscript><div class="container noscript-note">Контакты доступны в разделе «Контакты». Описания услуг показаны ниже. Для просмотра фотографий на весь экран включите JavaScript.</div></noscript>
  </main>

  <footer class="site-footer container"><div class="footer-brand"><a href="/">Вулкан Маркетинг</a><p>Маркетинговое агентство</p></div><nav aria-label="Навигация в подвале">{links.map(([href, label]) => <a href={href}>{label}</a>)}</nav><p class="footer-note">© {new Date().getFullYear()} Вулкан Маркетинг</p></footer>

  {services.map(service => <dialog id={`${service.id}-details`} class="detail-dialog" aria-labelledby={`${service.id}-title`}><div class="dialog-inner"><button class="dialog-close icon-button" type="button" data-close aria-label="Закрыть описание услуги"><Icon name="close"/></button><span class="eyebrow red">Услуги</span><h2 id={`${service.id}-title`}>{service.title}</h2>{service.detail.map(paragraph => <p class="service-detail-copy">{paragraph}</p>)}<ul>{service.items.map(item => <li><Icon name="check" size={18}/>{item}</li>)}</ul><h3 class="detail-subheading">Результат работы</h3><p>{service.result}</p>{service.timing && <><h3 class="detail-subheading">Срок</h3><p>{service.timing}</p></>}<p class="dialog-price">{service.pricePrefix}{service.price} ₽ <span>{service.unit}</span></p>{service.budget && <p class="detail-budget">{service.budget}</p>}<a class="button service-contact" href="#contact" data-contact-from-service>Обсудить задачу <Icon name="arrow" size={19}/></a></div></dialog>)}

  <dialog id="contact-dialog" class="project-dialog" aria-labelledby="contact-dialog-title"><div class="dialog-inner"><button class="dialog-close icon-button" type="button" data-close aria-label="Закрыть контакты"><Icon name="close"/></button><span class="eyebrow red">Начнём с разговора</span><h2 id="contact-dialog-title">Расскажите<br/>о своей задаче</h2><p>Напишите о бизнесе и о том, куда хотите его привести. Выберите удобный мессенджер для связи.</p><ContactLinks/><p class="contact-note">На сайте нет формы для сбора данных.</p></div></dialog>

  <dialog id="gallery-dialog" class="gallery-dialog" aria-labelledby="gallery-dialog-title"><div class="gallery-shell"><header class="gallery-toolbar"><h2 id="gallery-dialog-title">Фотографии кейса</h2><button class="gallery-close icon-button" type="button" data-close aria-label="Закрыть галерею"><Icon name="close" size={28}/></button></header><div class="gallery-stage"><button class="round-button previous" type="button" data-gallery-prev aria-label="Предыдущее изображение"><Icon name="arrow"/></button><figure><img id="gallery-image" alt=""/><figcaption id="gallery-caption"></figcaption></figure><button class="round-button" type="button" data-gallery-next aria-label="Следующее изображение"><Icon name="arrow"/></button></div><p class="gallery-position" data-gallery-count aria-live="polite" aria-atomic="true"></p></div></dialog>
  <script src="../scripts/site.ts"></script>
</BaseLayout>
