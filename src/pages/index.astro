---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CaseStudies from '../components/CaseStudies.astro';
import ClientReviews from '../components/ClientReviews.astro';
import MarketingCycle from '../components/MarketingCycle.astro';
import Icon from '../components/Icon.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { dzenChannelUrl, latestArticles } from '../data/articles';
import { services, contactIntro, contacts, telegramChannelUrl } from '../data/site';
import '../styles/landing.css';

const blogCards = latestArticles(3);
---
<BaseLayout>
  <SiteHeader />
  <main id="main">
    <Hero />
    <MarketingCycle />

    <CaseStudies />

    <section class="expertise section-space" id="expertise" aria-labelledby="expertise-heading">
      <div class="container landing-split">
        <h2 id="expertise-heading">Почитайте нашу экспертизу</h2>
        <div class="landing-copy">
          <p>Мы открыто рассказываем, как продвигаем проекты на Авито, чтобы предприниматели могли применять наши методы самостоятельно.</p>
          <p>В Telegram разбираем новости площадки и маркетинга, а в Дзене публикуем практические материалы по продвижению.</p>
          <div class="landing-links">
            <a class="button button-outline" href={telegramChannelUrl}>Telegram-канал <Icon name="arrow" size={18} /></a>
            <a class="button button-outline" href={dzenChannelUrl}>Дзен <Icon name="arrow" size={18} /></a>
          </div>
        </div>
      </div>
    </section>

    <ClientReviews />

    <section class="section-space" id="discuss" aria-labelledby="discuss-heading">
      <div class="container">
        <div class="discussion-panel">
          <div class="landing-copy">
            <h2 id="discuss-heading">Обсудим вашу задачу</h2>
            <p>{contactIntro}</p>
          </div>
          <div class="discussion-actions">
            <a class="button button-primary" href="#contact" data-dialog-open="contact-dialog">Написать нам <Icon name="arrow" size={20} /></a>
            <a class="formats-link" href="#services">Посмотреть форматы сотрудничества <Icon name="arrow" size={18} /></a>
          </div>
        </div>
      </div>
    </section>

    <section class="methods section-space" id="methods" aria-labelledby="methods-heading">
      <div class="container">
        <div class="landing-split methods-intro">
          <h2 id="methods-heading">Методы, которые нам помогают</h2>
          <p>Мы давно работаем с Авито и хорошо знаем правила площадки. Знаем и серые методы продвижения. Применяем их в тех проектах, где считаем это оправданным для стабильного и эффективного привлечения целевого трафика.</p>
        </div>
        <div class="methods-principles">
          <article class="method-principle">
            <h3>Когда применяем серые методы</h3>
            <div>
              <p>Вы могли слышать про масспостинг, дубли объявлений, перевыкладку и мультиаккаунтинг. Такие методы могут нарушать правила площадки и повлечь санкции. Мы отдаём себе отчёт в этих рисках и действуем с вашего согласия.</p>
              <p>По нашей практике, блокировок аккаунтов в таких проектах не было. Поэтому у нас нет практического опыта разблокировки профилей.</p>
            </div>
          </article>
          <article class="method-principle">
            <h3>Почему отказываемся от накруток</h3>
            <div>
              <p>Мы не прибегаем к накрутке поведенческих факторов и отзывов. По нашему опыту, она приносит пользу продавцам накруток, а рекламе мешает. Подробно о том, почему такие действия вредят профилю, рассказываем <a href={dzenChannelUrl}>в Дзене</a>.</p>
            </div>
          </article>
        </div>
        <div class="method-examples">
          <div>
            <h3>Два примера из практики</h3>
            <p>Мы используем известные методы продвижения и придумываем собственные.</p>
          </div>
          <dl>
            <div>
              <dt>Экономия на платных услугах</dt>
              <dd>Пару лет назад стоимость платных услуг для объявлений с разовым размещением зависела от региона. Мы нашли способ снизить расходы на продвижение за счёт разницы в тарифах.</dd>
            </div>
            <div>
              <dt>Ограничения «Адресов бизнеса»</dt>
              <dd>С ноября 2025 по март 2026 года Авито ограничивало число городов для публикации. Мы нашли собственное решение, чтобы сохранить охват. Ещё до снятия ограничений показатели превысили уровень до их введения. Динамику просмотров и контактов можно увидеть в <a href="#case-tentovaya-produktsiya" data-dialog-open="case-tentovaya-produktsiya-dialog" aria-haspopup="dialog">кейсе фабрики тентов</a>.</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="landing-contact section-space" id="contact" aria-labelledby="contacts-heading">
      <div class="container landing-split">
        <h2 id="contacts-heading">Наши контакты</h2>
        <div class="landing-copy">
          <p>Есть конкретный вопрос по продвижению на Авито? Выберите удобный мессенджер и напишите нам. На такие вопросы отвечаем бесплатно.</p>
          <p>Если мы уже разбирали вашу тему в блоге, пришлём материал и ответим на вопросы, которые останутся после прочтения. Если нужно обсудить работу над проектом, расскажите, чем занимаетесь и чего хотите добиться на Авито.</p>
          <div class="landing-links">
            {contacts.map(contact => <a class="button button-outline" href={contact.url}>{contact.name} <Icon name="arrow" size={18} /></a>)}
          </div>
        </div>
      </div>
    </section>

    <section class="section-space" id="services" aria-labelledby="services-heading">
      <div class="container">
        <h2 id="services-heading">Форматы сотрудничества</h2>
        <p class="formats-intro">Можно прийти за планом улучшений, передать профиль на ведение, заказать запуск или освоить автозагрузку на своём проекте.</p>
        <div class="formats-list">
          {services.map(service => (
            <article class="format-card" id={`${service.id}-details`}>
              <div class="format-heading">
                <span class="service-icon"><Icon name={service.icon} size={27} /></span>
                <h3>{service.title}</h3>
                <div class="format-price"><strong>{service.price}</strong>{service.unit && <span>{service.unit}</span>}</div>
              </div>
              <div class="format-content">
                {service.overview.map(paragraph => <p>{paragraph}</p>)}
                <details>
                  <summary>Что входит</summary>
                  <ul>{service.includes.map(item => <li>{item}</li>)}</ul>
                </details>
                <a class="button button-outline" href="#contact" data-dialog-open="contact-dialog" aria-haspopup="dialog">{service.action} <Icon name="arrow" size={17} /></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="landing-blog section-space" id="blog" aria-labelledby="home-blog-heading">
      <div class="container landing-split">
        <div class="landing-blog-intro">
          <h2 id="home-blog-heading">Блог об Авито</h2>
          <p>Пишем о продвижении, аналитике и продажах на Авито.</p>
          <a href="/blog/" class="button button-outline">Все статьи <Icon name="arrow" size={18} /></a>
        </div>
        <div class="landing-article-list">{blogCards.map(article => <ArticleCard article={article} showCover={false} />)}</div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
