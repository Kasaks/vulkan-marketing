---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { services, cases, metrics, benefits, steps, contacts, reviewSources } from '../data/site';
const links=[['#cases','Кейсы'],['#process','Как работаем'],['#services','Услуги'],['#reviews','Отзывы'],['#contact','Контакты']];
---
<BaseLayout>
<header class="site-header container"><a class="brand" href="/" aria-label="Вулкан Маркетинг — главная"><img src="/images/logo.jpg" alt="Вулкан Маркетинг" width="76" height="76"/></a><nav id="main-nav" class="main-nav" aria-label="Основная навигация">{links.map(([href,label])=><a href={href}>{label}</a>)}</nav><div class="header-actions"><button class="theme-toggle" type="button" aria-label="Переключить тему"><span class="sun"><Icon name="sun" size={17}/></span><span class="moon"><Icon name="moon" size={17}/></span></button><a class="button header-cta" href="#contact-dialog" data-dialog-open="contact-dialog">Обсудить задачу</a><button class="menu-toggle icon-button" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="main-nav"><Icon name="menu"/></button></div></header>
<main id="main">
<section class="hero container"><div class="hero-main"><p class="eyebrow">Маркетинговое агентство «Вулкан Маркетинг»</p><h1>Ваш отдел<br/>маркетинга<br/>на Авито<span class="red-period">.</span></h1><p class="hero-subtitle"><span class="dash"></span><span>Находим сильные и слабые стороны продукта. Усиливаем преимущества и устраняем недостатки.</span></p></div><div class="hero-aside"><p>Делаем результат понятнее, эффективнее и предсказуемее.</p><a class="button" href="#contact-dialog" data-dialog-open="contact-dialog">Обсудить задачу <Icon name="arrow"/></a><a class="text-link" href="#cases">Посмотреть кейсы</a><span class="hero-note">Расскажите нам о бизнесе и ваших целях.</span></div></section>
<section class="metrics container" aria-label="Показатели агентства">{metrics.map(([number,label])=><div class="metric"><strong>{number}</strong><span>{label}</span></div>)}</section>
<section class="services container section-space" id="services"><span class="dash"></span><h2>Стандартные форматы сотрудничества</h2><p class="section-intro">Найти точки улучшения, получить практические рекомендации или полностью делегировать ведение профиля.</p><div class="service-grid">{services.map(s=><article class="service"><div class="service-heading"><span class="service-icon"><Icon name={s.icon} size={35}/></span><h3>{s.title}</h3></div><p>{s.description}</p><div class="service-price">от {s.price} ₽ <span>{s.unit}</span></div><a class="text-link" href={`#${s.id}-details`} data-dialog-open={`${s.id}-details`}>Подробнее <Icon name="arrow"/></a></article>)}</div></section>
<section class="case-section" id="cases"><div class="container carousel" data-carousel="cases" tabindex="0"><p class="eyebrow">Кейсы · долгосрочные проекты</p><p class="case-intro">Актуальные данные по проектам предоставляем по запросу.</p>{cases.map((c,i)=><article class="case-slide" data-slide data-active={i===0?'true':'false'}><div class="case-copy"><h2>{c.title}</h2><p class="case-category">{c.category}</p><dl class="case-facts"><div><dt>Задача</dt><dd>{c.task}</dd></div><div><dt>Подход</dt><dd>{c.solution}</dd></div><div><dt>Результат</dt><dd>{c.result}</dd></div></dl></div><div class="case-gallery">{c.images.length ? c.images.map((src,j)=><button type="button" class="gallery-thumb" data-gallery-open data-image-index={j} aria-label={`Увеличить изображение ${j+1}`}><img src={src} alt={`Материалы кейса ${j+1}`} loading="lazy"/></button>) : <div class="gallery-placeholder"><Icon name="chart" size={48}/><p>Скриншоты статистики проекта будут добавлены после предоставления материалов.</p></div>}</div></article>)}<div class="carousel-controls case-controls"><button class="round-button previous" type="button" data-prev aria-label="Предыдущий кейс"><Icon name="arrow"/></button><button class="round-button accent" type="button" data-next aria-label="Следующий кейс"><Icon name="arrow"/></button><span class="carousel-count" data-count></span></div></div></section>
<section class="benefits container section-space" id="approach"><div><span class="dash"></span><h2>Понятно — что делаем.<br/>Видно — зачем.</h2></div><div class="benefit-list">{benefits.map(([title,description])=><article><span class="dash"></span><div><h3>{title}</h3><p>{description}</p></div></article>)}</div></section>
<section class="process container section-space" id="process"><span class="dash"></span><h2>От первого разговора до эффективной рекламы</h2><p class="section-intro">Гипотезы → запуск → анализ → правки. Повторяем цикл, чтобы повышать эффективность.</p><ol class="steps">{steps.map(([title,description],i)=><li><span class="step-number">0{i+1}</span><h3>{title}</h3><p>{description}</p></li>)}</ol></section>
<section class="reviews-section" id="reviews"><div class="container"><div class="review-heading"><span class="dash"></span><h2>Отзывы</h2></div><p>Здесь появятся реальные отзывы из Яндекс Бизнеса и Яндекс Исполнителей после подключения подтверждённых профилей.</p><div class="source-links">{reviewSources.map(s=>s.url?<a class="text-link" href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a>:<span>{s.name} · ожидаем ссылку</span>)}</div></div></section>
<section class="contact container section-space" id="contact"><div><span class="dash"></span><h2>Чем мы можем быть вам полезны?</h2><p>Что хотите изменить, улучшить или к каким показателям прийти? Напишите нам в удобном чате.</p></div><button class="button contact-button" type="button" data-dialog-open="contact-dialog">Обсудить задачу <Icon name="arrow"/></button></section>
</main>
<footer class="site-footer container"><div class="footer-brand"><a href="/">Вулкан Маркетинг</a><p>Ваш отдел маркетинга на Авито</p></div><nav aria-label="Навигация в подвале">{links.map(([href,label])=><a href={href}>{label}</a>)}</nav><p class="footer-note">© {new Date().getFullYear()} Вулкан Маркетинг</p></footer>
{services.map(s=><dialog id={`${s.id}-details`} class="detail-dialog"><div class="dialog-inner"><button class="dialog-close icon-button" type="button" data-close aria-label="Закрыть"><Icon name="close"/></button><span class="eyebrow red">Услуги</span><h2>{s.title}</h2><p>{s.detail}</p><ul>{s.items.map(item=><li><Icon name="check" size={18}/>{item}</li>)}</ul><p class="dialog-price">от {s.price} ₽ <span>{s.unit}</span></p><button class="button" type="button" data-contact-from-service>Обсудить задачу</button></div></dialog>)}
<dialog id="contact-dialog" class="project-dialog" aria-labelledby="contact-dialog-title"><div class="dialog-inner"><button class="dialog-close icon-button" type="button" data-close aria-label="Закрыть"><Icon name="close"/></button><span class="eyebrow red">Связаться с нами</span><h2 id="contact-dialog-title">Обсудим вашу задачу</h2><p>Выберите удобный мессенджер. На сайте нет формы сбора заявок.</p><div class="contact-links">{contacts.map(c=>c.url?<a class="button" href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>:<span class="contact-pending">{c.name} · ссылка пока не добавлена</span>)}</div></div></dialog>
<dialog id="gallery-dialog" class="gallery-dialog" aria-label="Просмотр изображений"><button type="button" data-close aria-label="Закрыть галерею">×</button><button type="button" data-gallery-prev aria-label="Предыдущее изображение">←</button><img alt="Увеличенный скриншот кейса"/><button type="button" data-gallery-next aria-label="Следующее изображение">→</button></dialog>
<script src="../scripts/site.ts"></script>
</BaseLayout>