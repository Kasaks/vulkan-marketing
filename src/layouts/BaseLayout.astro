---
import { site } from '../data/site';
import '../styles/global.css';
interface Props { title?: string; description?: string; noIndex?: boolean; image?: string; pageType?: 'website' | 'article'; publishedTime?: string; }
const { title = site.title, description = site.description, noIndex = false, image, pageType = 'website', publishedTime } = Astro.props;
const socialImage = new URL(image || '/images/logo.jpg', Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
const indexable = !noIndex && !site.demoMode && import.meta.env.SITE_INDEXABLE === 'true';
const organizationId = new URL('/#organization', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': organizationId, name: site.name, url: Astro.site?.href, logo: new URL('/images/logo.jpg', Astro.site).href },
    { '@type': 'WebSite', '@id': new URL('/#website', Astro.site).href, url: Astro.site?.href, name: site.name, inLanguage: 'ru-RU', publisher: { '@id': organizationId } },
    { '@type': 'WebPage', '@id': canonical.href, url: canonical.href, name: title, description, inLanguage: 'ru-RU', isPartOf: { '@id': new URL('/#website', Astro.site).href } },
    ...(pageType === 'article' ? [{
      '@type': 'BlogPosting',
      '@id': canonical.href + '#article',
      headline: title,
      description,
      mainEntityOfPage: canonical.href,
      publisher: { '@id': organizationId },
      ...(publishedTime ? { datePublished: publishedTime } : {}),
      ...(image ? { image: socialImage.href } : {}),
    }] : []),
  ],
};
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fcfaf8" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={image ? `Изображение к материалу «${title}»` : "Логотип агентства Вулкан Маркетинг"} />
    {publishedTime && pageType === 'article' && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const saved = localStorage.getItem('vulkan-theme');
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : 'light';
      } catch { document.documentElement.dataset.theme = 'light'; }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <slot />
  </body>
</html>
