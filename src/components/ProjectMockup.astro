---
interface Props { project: { mockTitle: string; mockCopy: string; mockBrand: string; accent: string; theme: string; }; }
const { project } = Astro.props;
---
<div class:list={['project-visual', project.theme]} aria-hidden="true" style={`--project-accent: ${project.accent}`}>
  <div class="back-window"><div class="back-window-line"></div><div class="back-window-square"></div></div>
  <div class="laptop">
    <div class="laptop-screen">
      <div class="mini-nav"><span>{project.mockBrand}</span><div>Услуги&nbsp;&nbsp;&nbsp; О компании&nbsp;&nbsp;&nbsp; Контакты</div><b>Оставить заявку ↗</b></div>
      <div class="mini-hero">
        <div class="mini-copy"><h3>{project.mockTitle}</h3><p>{project.mockCopy}</p><span>Обсудить задачу <span>↗</span></span></div>
        <div class="mini-art">
          {project.theme === 'architecture' && <svg viewBox="0 0 290 300" fill="none"><path d="M28 300V107L168 21l94 58v221Z" fill="#aebfc6"/><path d="m28 107 140-86v279H28Z" fill="#d4e0e4"/><path d="m168 21 94 58v221h-94Z" fill="#536d79"/><g stroke="#78939e" stroke-width="2"><path d="m28 145 140-72M28 186l140-58M28 227l140-43M28 269l140-27M62 86v214M98 64v236M132 43v257"/></g><g stroke="#c7d6db" stroke-width="2"><path d="m168 73 94 43m-94 13 94 32m-94 23 94 25m-94 33 94 14M194 37v263M227 58v242"/></g><path d="M13 300v-66M3 252l10-15 11 15M249 300v-53m-12 22 12-17 12 17" stroke="#4c665b" stroke-width="5"/></svg>}
          {project.theme === 'interior' && <div class="interior-art"><i></i><b></b><span></span><em></em></div>}
          {project.theme === 'technology' && <div class="technology-art"><i></i><b></b><span></span></div>}
        </div>
      </div>
      <div class="mini-features"><span>◎ <b>Внимание к деталям</b></span><span>◇ <b>Понятный процесс</b></span><span>↗ <b>Под вашу задачу</b></span></div>
    </div>
    <div class="laptop-base"></div>
  </div>
  <span class="visual-caption">Демонстрация подачи проекта</span>
</div>
