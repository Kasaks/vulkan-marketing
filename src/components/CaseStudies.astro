---
import Icon from './Icon.astro';
import { cases, caseImagePath } from '../data/cases';
---

<section class="case-section section-space" id="cases" aria-labelledby="cases-heading">
  <div class="container">
    <h2 id="cases-heading">Вот что у нас получается</h2>
    <p class="cases-intro">Мы гордимся успехами клиентов и рады, что наша работа помогает их бизнесам расти. В кейсах рассказываем, с чего начался каждый проект и как менялись его показатели на Авито.</p>
    <div class="case-features">
      {cases.map(project => {
        const cover = project.story.find(section => 'screenshots' in section)?.screenshots[0];
        const anchor = `case-${project.slug}`;
        const dialogId = `${anchor}-dialog`;
        return (
          <article class="case-feature" id={anchor} data-case-dialog={dialogId}>
            <div class="case-feature-copy">
              <h3>{project.title}</h3>
              <p>{project.preview}</p>
              <div class="case-feature-result"><strong>{project.metric}</strong><span>{project.period}</span></div>
              <a class="case-feature-link" href={`#${anchor}`} data-dialog-open={dialogId} aria-haspopup="dialog" aria-label={`Смотреть кейс «${project.title}»`}>Смотреть кейс <Icon name="arrow" size={19} /></a>
            </div>
            {cover && <figure class="case-feature-figure">
              <img src={caseImagePath(cover.number)} alt={cover.caption} loading="lazy" />
              <figcaption>{cover.caption}</figcaption>
            </figure>}
          </article>
        );
      })}
    </div>
  </div>
</section>

{cases.map(project => {
  const dialogId = `case-${project.slug}-dialog`;
  return (
    <dialog class="case-dialog" id={dialogId} aria-labelledby={`${dialogId}-title`}>
      <div class="case-dialog-frame">
        <div class="case-dialog-controls">
          <button type="button" class="icon-button" data-close aria-label="Закрыть кейс"><Icon name="close" /></button>
        </div>
        <article class="case-dialog-story">
          <h2 id={`${dialogId}-title`}>{project.title}</h2>
          {project.story.map(section => 'paragraphs' in section ? (
            <div class="case-dialog-paragraphs">
              {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
            </div>
          ) : (
            <div class="case-dialog-figures">
              {section.screenshots.map(shot => (
                <figure>
                  <a href={caseImagePath(shot.number)} target="_blank" rel="noopener" aria-label={`Открыть изображение: ${shot.caption}`}>
                    <img src={caseImagePath(shot.number)} alt={shot.caption} loading="lazy" />
                  </a>
                  <figcaption>{shot.caption}</figcaption>
                </figure>
              ))}
            </div>
          ))}
        </article>
      </div>
    </dialog>
  );
})}

<style>
  .cases-intro { margin-top: 20px; max-width: 63ch; color: #d0dbdf; font-size: 18px; line-height: 1.6; }
  .case-features { display: grid; gap: clamp(22px, 4vw, 56px); margin-top: clamp(28px, 4vw, 55px); }

  .case-feature {
    display: grid;
    grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr);
    align-items: center;
    gap: clamp(22px, 4vw, 70px);
    min-height: min(650px, 82svh);
    padding: clamp(24px, 4vw, 65px);
    border: 1px solid #ffffff30;
    border-radius: 27px;
    background: #ffffff08;
    scroll-margin-top: 20px;
  }

  .case-feature h3 { font-size: clamp(25px, 3vw, 45px); text-wrap: balance; }
  .case-feature-copy > p { margin-top: 17px; color: #d0dbdf; font-size: 16px; line-height: 1.6; }
  .case-feature-result { display: grid; gap: 6px; margin-top: 27px; color: #d0dbdf; font-size: 14px; }
  .case-feature-result strong { color: #fff; font-size: clamp(27px, 3vw, 45px); line-height: 1.05; letter-spacing: -.04em; }
  .case-feature-link { display: inline-flex; align-items: center; gap: 10px; margin-top: 23px; color: #ffa5ae; font-weight: 700; }
  .case-feature-link:hover { text-decoration: underline; text-underline-offset: 4px; }

  figure { margin: 0; }
  figcaption { margin-top: 8px; font-size: 13px; }
  .case-feature-figure figcaption { color: #d0dbdf; }
  .case-feature-figure img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; border-radius: 14px; background: #fff; }

  .case-dialog { width: min(900px, calc(100% - 32px)); max-width: none; max-height: calc(100dvh - 32px); overflow-y: auto; }
  .case-dialog-controls { position: sticky; top: 0; display: flex; justify-content: flex-end; background: var(--paper); z-index: 1; padding: 8px 11px; }
  .case-dialog-story { display: grid; gap: 21px; padding: 0 clamp(17px, 4vw, 55px) clamp(26px, 5vw, 55px); }
  .case-dialog-story h2 { font-size: clamp(27px, 4vw, 49px); text-wrap: balance; }
  .case-dialog-paragraphs { display: grid; gap: 13px; max-width: 71ch; }
  .case-dialog-paragraphs p { font-size: 16px; line-height: 1.7; color: var(--ink); }
  .case-dialog-figures { display: grid; gap: 15px; }
  .case-dialog-figures a { display: block; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: #fff; cursor: zoom-in; }
  .case-dialog-figures img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; }
  .case-dialog-figures figcaption { color: var(--muted); }

  @media (max-width: 760px) {
    .case-feature { grid-template-columns: minmax(0, 1fr); min-height: 0; padding: 19px; gap: 22px; border-radius: 18px; }
    .case-feature-result { margin-top: 18px; }
    .case-feature-link { margin-top: 15px; }
    .case-dialog { width: calc(100% - 18px); max-height: calc(100dvh - 18px); }
  }
</style>
