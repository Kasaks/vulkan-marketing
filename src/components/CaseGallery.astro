---
import Icon from './Icon.astro';
import type { CaseStudy } from '../data/site';
interface Props { project: CaseStudy; }
const { project } = Astro.props;
---
<div class="case-gallery" data-case-gallery data-gallery-images={JSON.stringify(project.images)} data-gallery-title={project.title.replace(/\n/g, ' ')}>
  {project.images.length > 0 ? <>
    <button type="button" class="gallery-cover" data-gallery-open="0" aria-label="Открыть фотографии кейса на весь экран">
      <img src={project.images[0].src} alt={project.images[0].alt} width="1000" height="750" loading="lazy"/>
      <span class="gallery-zoom"><Icon name="zoom" size={25}/></span>
    </button>
    <div class="gallery-thumbnails" aria-label="Фотографии кейса">{project.images.map((image, index) => <button type="button" data-gallery-open={String(index)} aria-label={`Открыть фотографию ${index + 1} из ${project.images.length}`}><img src={image.src} alt={image.alt} width="100" height="75" loading="lazy"/></button>)}</div>
    <p class="gallery-hint">Откройте снимок, чтобы рассмотреть детали</p>
  </> : <div class="gallery-empty"><span class="gallery-empty-icon"><Icon name="image" size={54}/></span><p>Скриншоты проекта</p><span>Здесь появится помесячная статистика за последний год работы.</span></div>}
</div>
