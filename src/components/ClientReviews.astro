---
import Icon from './Icon.astro';

const yandexReviewsUrl = 'https://yandex.ru/maps/org/vulkan_marketing/229129493851/reviews/';
const telegramReviewsUrl = 'https://t.me/+-Jhv8nykbHkxN2Y6';

// Review texts, ratings and dates are from the Yandex Maps organization card.
const reviews = [
  {
    author: 'Sport Detyam',
    date: '2025-02-21',
    displayDate: '21 февраля 2025',
    text: "Большая благодарность Владимиру! Со мной работало много разных авитологов и первый раз вижу настолько глубокое включение в процесс. С разработкой и проверкой гипотез, автоматически без напоминания все включается, собирает статистику, делает выводы и на основании этого прокладывается дальнейший маршрут и план действий. В общем то как и должно быть, но повторюсь первый раз так все тщательно делается. В основном все взяли деньги, запустили автозагрузкой и дальше пусть хоть что там творится. А здесь был приятно удивлен! Однозначно рекомендую!",
  },
  {
    author: 'Valeria Star',
    date: '2025-01-21',
    displayDate: '21 января 2025',
    text: "Обратилась за проведением диагностики моего аккаунта авито, очень понравилось, что Владимир подготовился к консультации досканально\n\nМне рассказали и про мои нелепые текста в объявлениях и показали всех топовых аонкурентов\n\nЕще раз спасибо ! И отдельное спасибо за план дальнейших действий 👍",
  },
  {
    author: 'Евгений Т.',
    date: '2025-01-22',
    displayDate: '22 января 2025',
    text: "Спасибо Владимиру за консультацию, разобрали тему кузовных автосервисов, определили стратегию, план действий и нашли сильных конкурентов, буду реализовывать 🤝",
  },
  {
    author: 'Anastasia',
    date: '2025-02-27',
    displayDate: '27 февраля 2025',
    text: "Очень довольна общением и сотрудничеством с Владимиром. \nСначала я взяла обучение по автозагрузке Авито, Владимир очень подробно рассказал, как правильно и самое главное удобно организовать хранение информации для выгрузки большого количества ассортимента товаров (у нас категория автозапчастей на Авито, приходится работать с огромным количеством наименований). Этот практический урок сильно помог нам понять, что нужно изменить в бизнес-процессе. Большое спасибо!\n\nТакже мы воспользовались услугой автовыгрузки на Авито и помощи в продвижении профиля. Остались очень довольны качеством оказанных услуг. Благодарим за оперативность, чёткость и надёжность. \n\nОднозначно буду рекомендовать Владимира коллегам, а также привлекать к другим проектам!\n\n",
  },
];
---

<section class="reviews-section section-space" id="reviews" aria-labelledby="reviews-heading">
  <div class="container reviews-layout">
    <div>
      <h2 id="reviews-heading">Отзывы наших клиентов</h2>
      <p class="reviews-description">Отзывы о ведении профиля, консультациях и обучении автозагрузке.</p>
    </div>
    <div class="reviews-content">
      <div class="review-carousel" data-carousel="reviews" role="group" aria-roledescription="карусель" aria-label="Отзывы с оценкой пять из пяти" tabindex="0">
        <div class="review-slides" id="review-slides">
          {reviews.map((review, index) => (
            <figure class="client-review" data-slide data-active={index === 0 ? 'true' : 'false'}>
              <span class="review-stars" role="img" aria-label="Оценка 5 из 5">★★★★★</span>
              <blockquote cite={yandexReviewsUrl}>{review.text}</blockquote>
              <figcaption><strong>{review.author}</strong> <time datetime={review.date}>{review.displayDate}</time></figcaption>
            </figure>
          ))}
        </div>
        <div class="carousel-controls review-controls">
          <button class="round-button previous" type="button" data-prev aria-label="Предыдущий отзыв" aria-controls="review-slides"><Icon name="arrow" size={22} /></button>
          <span data-count aria-live="polite" aria-atomic="true">01 / {String(reviews.length).padStart(2, '0')}</span>
          <button class="round-button" type="button" data-next aria-label="Следующий отзыв" aria-controls="review-slides"><Icon name="arrow" size={22} /></button>
        </div>
      </div>
      <div class="review-links">
        <a href={yandexReviewsUrl}>Читать отзывы на Яндекс Картах <Icon name="arrow" size={18} /></a>
        <a href={telegramReviewsUrl}>Отзывы в Telegram <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-layout { align-items: start; }
  .reviews-content { min-width: 0; }
  .review-carousel { touch-action: pan-y pinch-zoom; }
  .review-slides { display: grid; gap: 14px; }
  .client-review {
    display: flex;
    flex-direction: column;
    min-height: 238px;
    margin: 0;
    padding: clamp(20px, 3vw, 37px);
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--paper);
  }
  .review-stars { color: var(--ink); font-size: 17px; letter-spacing: .19em; }
  .client-review blockquote { margin: 13px 0 20px; color: var(--ink); font-size: 16px; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; }
  .client-review figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; margin-top: auto; color: var(--muted); font-size: 14px; }
  .client-review figcaption strong { color: var(--ink); }
  .review-controls { margin-top: 14px; justify-content: flex-end; }
  .review-controls .round-button { border-color: var(--line); background: var(--paper); color: var(--ink); }
  .review-controls .round-button:hover { border-color: var(--accent); color: var(--accent); }
  [data-count] { min-width: 54px; color: var(--muted); font-size: 13px; text-align: center; font-variant-numeric: tabular-nums; }
  .review-links { display: flex; flex-wrap: wrap; gap: 13px 23px; margin-top: 21px; }
  .review-links a { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 700; }
  .review-links a:hover { text-decoration: underline; text-underline-offset: 4px; }
</style>
