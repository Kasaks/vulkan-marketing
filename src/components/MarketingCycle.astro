---
import Icon from './Icon.astro';
import { workCycle } from '../data/site';
---

<section class="marketing-cycle section-space" id="work-cycle" aria-labelledby="work-cycle-title">
  <div class="container cycle-layout">
    <div class="cycle-heading">
      <h2 id="work-cycle-title">Как мы добиваемся <em>лучших показателей</em></h2>
      <p>Сначала изучаем нишу и готовим объявления. После запуска смотрим статистику и переписки, чтобы понять, какие объявления приводят целевые обращения и что стоит улучшить.</p>
    </div>
    <div class="cycle-diagram">
      <div class="cycle-track">
        <ol class="cycle-steps" role="list">
          {workCycle.map(stage => (
            <li class="cycle-step">
              <h3>{stage.title}</h3>
              <p>{stage.description}</p>
            </li>
          ))}
        </ol>
        <span class="cycle-return" aria-hidden="true"></span>
      </div>
      <p class="cycle-caption"><Icon name="repeat" size={20} /> Собираем статистику и возвращаемся к анализу</p>
    </div>
  </div>
</section>

<style>
  .marketing-cycle { background: var(--soft); border-block: 1px solid var(--line); }

  .cycle-layout {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    gap: clamp(30px, 6vw, 100px);
    align-items: center;
  }

  .cycle-heading h2 { font-size: clamp(34px, 4.35vw, 66px); text-wrap: balance; }
  .cycle-heading em { color: var(--accent); font-style: normal; }
  .cycle-heading p { max-width: 44ch; margin-top: 24px; font-size: 18px; line-height: 1.65; }
  .cycle-track { position: relative; padding-right: 30px; }
  .cycle-steps { display: grid; gap: 28px; list-style: none; }

  .cycle-step {
    position: relative;
    padding: 18px 24px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--paper);
  }

  .cycle-step h3 { font-size: clamp(20px, 2.15vw, 28px); }
  .cycle-step p { margin-top: 6px; line-height: 1.45; }

  .cycle-step:not(:last-child)::before,
  .cycle-step:not(:last-child)::after,
  .cycle-return::before {
    content: '';
    position: absolute;
  }

  .cycle-step:not(:last-child)::before {
    width: 2px;
    height: 17px;
    background: var(--accent);
    top: calc(100% + 5px);
    left: calc(50% - 1px);
  }

  .cycle-step:not(:last-child)::after {
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    top: calc(100% + 14px);
    left: calc(50% - 4px);
    transform: rotate(45deg);
  }

  .cycle-return {
    position: absolute;
    inset: 29px 0 29px auto;
    width: 31px;
    border: 2px solid var(--accent);
    border-left: 0;
    border-radius: 0 18px 18px 0;
    pointer-events: none;
  }

  .cycle-return::before {
    width: 8px;
    height: 8px;
    top: -5px;
    left: 0;
    border-left: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(45deg);
  }

  .cycle-caption {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-size: 14px;
    line-height: 1.4;
    margin-top: 16px;
  }

  .cycle-caption :global(svg) { color: var(--accent); flex: none; }

  @media (max-width: 760px) {
    .cycle-layout { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .cycle-heading p { margin-top: 16px; font-size: 16px; }
    .cycle-step { padding: 15px 16px; }
    .cycle-step p { font-size: 14px; }
  }
</style>
