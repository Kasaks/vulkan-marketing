---
import Icon from './Icon.astro';
import { contacts, contactIntro, navigation, navigationHref } from '../data/site';
interface Props { active?: 'home' | 'blog'; }
const { active = 'home' } = Astro.props;
const contactHref = navigationHref('contact', Astro.url.pathname);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Вулкан Маркетинг — на главную">
      <img src="/images/logo.jpg" alt="" width="64" height="64" />
      <span class="brand-copy"><strong>Вулкан Маркетинг</strong></span>
    </a>
    <nav id="main-nav" class="main-nav" aria-label="Основная навигация">
      {navigation.map(link => <a href={navigationHref(link.anchor, Astro.url.pathname)} aria-current={active === 'blog' && link.anchor === 'blog' ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <button class="theme-toggle" type="button" aria-label="Переключить тему"><span class="sun"><Icon name="sun" size={18} /></span><span class="moon"><Icon name="moon" size={18} /></span></button>
      <a class="button button-primary header-cta" href={contactHref} data-dialog-open="contact-dialog">Обсудить задачу <Icon name="arrow" size={20} /></a>
      <button class="menu-toggle icon-button" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="main-nav"><Icon name="menu" /></button>
    </div>
  </div>
</header>

<dialog id="contact-dialog" class="project-dialog" aria-labelledby="contact-dialog-title">
  <div class="dialog-inner">
    <button class="dialog-close icon-button" type="button" data-close aria-label="Закрыть"><Icon name="close" /></button>
    <span class="section-kicker">Связаться с нами</span>
    <h2 id="contact-dialog-title">Обсудить задачу</h2>
    <p>{contactIntro}</p>
    <div class="contact-links">
      {contacts.map(contact => <a class="button button-primary" href={contact.url}>{contact.name} <Icon name="arrow" size={18} /></a>)}
    </div>
  </div>
</dialog>
<script src="../scripts/site.ts"></script>
