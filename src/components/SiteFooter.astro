---
import { navigation, navigationHref } from '../data/site';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand"><a href="/">Вулкан Маркетинг</a><p>Ваш отдел маркетинга на Авито</p></div>
    <nav aria-label="Навигация в подвале">
      {navigation.map(link => <a href={navigationHref(link.anchor, Astro.url.pathname)}>{link.label}</a>)}
    </nav>
    <p class="footer-note">© {new Date().getFullYear()} Вулкан Маркетинг</p>
  </div>
</footer>
